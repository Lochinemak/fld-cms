// Conventions: snake_case table/column names, BigInt snowflake IDs generated by the application
// (no database default), timestamps stored as timestamptz.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tenant. id = 1 is reserved for the system tenant.
model Tenant {
  id        BigInt       @id
  code      String       @unique @db.VarChar(64)
  name      String       @db.VarChar(128)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  DISABLED

  @@map("tenant_status")
}
