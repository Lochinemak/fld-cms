// Conventions: snake_case table/column names, BigInt snowflake IDs generated by the application
// (no database default), timestamps stored as timestamptz.
//
// Tenant-owned rows carry tenant_id. Where every column of a relation is required, the foreign
// key includes tenant_id so the database itself refuses links across tenants; nullable links
// (a member's department, a department's parent) are checked by the services instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tenant. id = 1 is reserved for the system tenant.
model Tenant {
  id              BigInt       @id
  code            String       @unique @db.VarChar(64)
  name            String       @db.VarChar(128)
  status          TenantStatus @default(ACTIVE)
  /// Codes of the modules switched off for the tenant, which works with all the others.
  disabledModules String[]     @default([]) @map("disabled_modules")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  members         TenantMember[]
  departments     Department[]
  roles           Role[]
  sessions        Session[]
  lastUsedByUsers User[]
  customers       Customer[]
  contacts        Contact[]
  followUps       FollowUp[]
  opportunities   Opportunity[]
  fileFolders     FileFolder[]
  files           StoredFile[]
  fileVersions    FileVersion[]
  fileShares      FileShare[]
  fileRefs        FileRef[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  DISABLED

  @@map("tenant_status")
}

/// Sign-in account, shared by every tenant the person belongs to.
model User {
  id                 BigInt     @id
  /// Lowercase; unique across all tenants.
  username           String     @unique @db.VarChar(64)
  /// Lowercase; unique across all tenants.
  email              String?    @unique @db.VarChar(254)
  displayName        String     @map("display_name") @db.VarChar(64)
  /// Null for accounts that only sign in through OIDC.
  passwordHash       String?    @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  status             UserStatus @default(ACTIVE)
  /// Wrong passwords in a row since the last sign-in; too many lock the account.
  failedSignIns      Int        @default(0) @map("failed_sign_ins")
  /// Locked accounts can't sign in until an administrator unlocks them or the password is reset.
  lockedAt           DateTime?  @map("locked_at") @db.Timestamptz(3)
  /// Where the next sign-in lands.
  lastTenantId       BigInt?    @map("last_tenant_id")
  lastSignInAt       DateTime?  @map("last_sign_in_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  lastTenant         Tenant?        @relation(fields: [lastTenantId], references: [id], onDelete: SetNull)
  memberships        TenantMember[]
  identities         UserIdentity[]
  ownedCustomers     Customer[]     @relation("CustomerOwner")
  createdCustomers   Customer[]     @relation("CustomerCreator")
  ownedOpportunities Opportunity[]
  followUps          FollowUp[]
  ownedFileFolders   FileFolder[]   @relation("FileFolderOwner")
  createdFileFolders FileFolder[]   @relation("FileFolderCreator")
  ownedFiles         StoredFile[]   @relation("StoredFileOwner")
  createdFiles       StoredFile[]   @relation("StoredFileCreator")
  fileVersions       FileVersion[]
  fileShares         FileShare[]
  fileRefs           FileRef[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// A user's membership of one tenant, holding everything that differs per tenant.
model TenantMember {
  id        BigInt       @id
  tenantId  BigInt       @map("tenant_id")
  userId    BigInt       @map("user_id")
  deptId    BigInt?      @map("dept_id")
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [deptId], references: [id], onDelete: SetNull)
  roles      MemberRole[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@index([deptId])
  @@map("tenant_members")
}

enum MemberStatus {
  ACTIVE
  DISABLED

  @@map("member_status")
}

model Department {
  id        BigInt   @id
  tenantId  BigInt   @map("tenant_id")
  parentId  BigInt?  @map("parent_id")
  name      String   @db.VarChar(64)
  /// Ids from the root down to this department, e.g. "/12/34/", for subtree queries.
  path      String   @db.VarChar(1024)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent        Department?      @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Department[]     @relation("DepartmentTree")
  members       TenantMember[]
  roleScopes    RoleDepartment[]
  customers     Customer[]
  opportunities Opportunity[]
  fileFolders   FileFolder[]
  files         StoredFile[]

  @@unique([tenantId, id])
  @@index([parentId])
  @@map("departments")
}

model Role {
  id          BigInt    @id
  tenantId    BigInt    @map("tenant_id")
  code        String    @db.VarChar(64)
  name        String    @db.VarChar(64)
  description String?   @db.VarChar(255)
  /// Built-in roles hold every permission the tenant may grant and cannot be edited or deleted.
  builtin     Boolean   @default(false)
  dataScope   DataScope @default(SELF) @map("data_scope")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     MemberRole[]
  permissions RolePermission[]
  departments RoleDepartment[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("roles")
}

/// Which rows a role may see: everything, its department (with or without sub-departments),
/// only its own, or a chosen set of departments (role_departments).
enum DataScope {
  ALL
  DEPT_AND_CHILDREN
  DEPT
  SELF
  CUSTOM

  @@map("data_scope")
}

model MemberRole {
  tenantId BigInt @map("tenant_id")
  memberId BigInt @map("member_id")
  roleId   BigInt @map("role_id")

  member TenantMember @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  role   Role         @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([tenantId, roleId])
  @@map("member_roles")
}

model RolePermission {
  roleId     BigInt @map("role_id")
  /// A code from the shared permission registry, e.g. "system:member:create".
  permission String @db.VarChar(128)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

/// The departments a role with data scope CUSTOM may see.
model RoleDepartment {
  tenantId BigInt @map("tenant_id")
  roleId   BigInt @map("role_id")
  deptId   BigInt @map("dept_id")

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  department Department @relation(fields: [tenantId, deptId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, deptId])
  @@index([tenantId, deptId])
  @@map("role_departments")
}

/// Sign-in sessions of @nestjs/authentication. The id is the SHA-256 of the cookie token.
/// user_id is text without a foreign key, as the package's store contract expects; the session
/// provider ends sessions whose user no longer exists.
model Session {
  id           String   @id
  userId       String   @map("user_id")
  /// The tenant this sign-in works in; null falls back to the user's last tenant.
  tenantId     BigInt?  @map("tenant_id")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  lastActiveAt DateTime @map("last_active_at") @db.Timestamptz(3)
  mfa          String?  @db.VarChar(16)
  metadata     Json?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A user's authenticator app (TOTP) for signing in in two steps. The secret is sealed with
/// SETTINGS_ENCRYPTION_KEY. Keyed by the user id as text, like sessions.
model UserTotp {
  userId        String   @id @map("user_id")
  secret        String   @db.VarChar(512)
  confirmed     Boolean
  /// A replacement being set up; `secret` works until it is confirmed.
  pendingSecret String?  @map("pending_secret") @db.VarChar(512)
  /// The last 30-second step a code was accepted for: each works once.
  lastUsedStep  BigInt?  @map("last_used_step")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_totp")
}

/// One-time codes for signing in without the authenticator app, stored hashed.
model MfaRecoveryCode {
  userId String @map("user_id")
  hash   String @db.VarChar(255)

  @@id([userId, hash])
  @@map("mfa_recovery_codes")
}

/// An external identity (OIDC) linked to a user.
model UserIdentity {
  id        BigInt   @id
  userId    BigInt   @map("user_id")
  /// Which identity provider, e.g. "google" or a tenant's own IdP.
  provider  String   @db.VarChar(64)
  /// The provider's subject claim.
  subject   String   @db.VarChar(255)
  email     String?  @db.VarChar(254)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}

/// A link sent by mail, such as a password reset: the authentication module's email token store.
/// Only the token's SHA-256 is kept; the token itself only exists in the mail.
model EmailToken {
  /// SHA-256 of the token, base64url.
  id          String   @id @db.VarChar(64)
  purpose     String   @db.VarChar(32)
  userId      String   @map("user_id")
  /// The address the link was sent to, the only one it works for.
  email       String   @db.VarChar(254)
  /// For a password reset, a hash of the password it replaces: changing the password voids the link.
  fingerprint String?  @db.VarChar(64)
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_tokens")
}

/// Platform settings made on the settings page, each overriding its environment variable. A key
/// without a row is unset.
model PlatformSetting {
  key       String   @id @db.VarChar(100)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

/// Something the audit log keeps: a sign-in, an administrative change, data deleted or handed
/// over. Never changed, and removed after the retention period. Without foreign keys, so the
/// record outlives what it names; names are copied as they were at the time.
model AuditLog {
  id            BigInt   @id
  /// The tenant it happened in. Null for events of an account itself.
  tenantId      BigInt?  @map("tenant_id")
  /// For events of an account itself (its sign-ins and password), the account: every tenant it
  /// belongs to sees them. With both null, an attempt that named no account, which the platform sees.
  accountId     BigInt?  @map("account_id")
  actorId       BigInt?  @map("actor_id")
  /// What a failed sign-in typed when it matched no account.
  actorUsername String?  @map("actor_username") @db.VarChar(254)
  actorName     String?  @map("actor_name") @db.VarChar(64)
  action        String   @db.VarChar(64)
  targetType    String?  @map("target_type") @db.VarChar(32)
  targetId      BigInt?  @map("target_id")
  targetName    String?  @map("target_name") @db.VarChar(255)
  success       Boolean
  reason        String?  @db.VarChar(255)
  /// The changed fields in words: [{ field, from, to }].
  changes       Json?
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  /// The X-Request-Id of the request, to find its lines in the API's log.
  requestId     String?  @map("request_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([accountId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// CRM. Customers and opportunities belong to an owner (a user) and remember the owner's
// department at the time, which is what department data scopes go by. Contacts and follow-ups
// are visible to whoever can see their customer.

/// A company or person the tenant sells to.
model Customer {
  id             BigInt          @id
  tenantId       BigInt          @map("tenant_id")
  name           String          @db.VarChar(128)
  industry       String?         @db.VarChar(64)
  source         CustomerSource?
  level          CustomerLevel   @default(B)
  status         CustomerStatus  @default(POTENTIAL)
  phone          String?         @db.VarChar(32)
  address        String?         @db.VarChar(255)
  remark         String?         @db.VarChar(1000)
  ownerId        BigInt          @map("owner_id")
  /// The owner's department when the customer was created or last transferred.
  deptId         BigInt?         @map("dept_id")
  creatorId      BigInt          @map("creator_id")
  /// Copied from the latest follow-up.
  lastFollowUpAt DateTime?       @map("last_follow_up_at") @db.Timestamptz(3)
  /// Copied from the latest follow-up.
  nextFollowUpAt DateTime?       @map("next_follow_up_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner         User          @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator       User          @relation("CustomerCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  department    Department?   @relation(fields: [deptId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  followUps     FollowUp[]
  opportunities Opportunity[]

  @@unique([tenantId, id])
  @@index([ownerId])
  @@index([deptId])
  @@index([creatorId])
  @@index([tenantId, nextFollowUpAt])
  @@map("customers")
}

enum CustomerSource {
  ONLINE
  REFERRAL
  EVENT
  OUTBOUND
  OTHER

  @@map("customer_source")
}

enum CustomerLevel {
  A
  B
  C

  @@map("customer_level")
}

enum CustomerStatus {
  POTENTIAL
  WON
  LOST

  @@map("customer_status")
}

/// A person at a customer.
model Contact {
  id         BigInt   @id
  tenantId   BigInt   @map("tenant_id")
  customerId BigInt   @map("customer_id")
  name       String   @db.VarChar(64)
  title      String?  @db.VarChar(64)
  phone      String?  @db.VarChar(32)
  email      String?  @db.VarChar(254)
  /// The customer's main contact; the service keeps at most one per customer.
  primary    Boolean  @default(false) @map("is_primary")
  remark     String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  followUps FollowUp[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@map("contacts")
}

/// A record of reaching out to a customer: a call, a visit, a meeting. Never edited.
model FollowUp {
  id            BigInt         @id
  tenantId      BigInt         @map("tenant_id")
  customerId    BigInt         @map("customer_id")
  contactId     BigInt?        @map("contact_id")
  opportunityId BigInt?        @map("opportunity_id")
  method        FollowUpMethod
  content       String         @db.VarChar(2000)
  followedAt    DateTime       @map("followed_at") @db.Timestamptz(3)
  /// When to follow up next.
  nextAt        DateTime?      @map("next_at") @db.Timestamptz(3)
  authorId      BigInt         @map("author_id")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  contact     Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  author      User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, customerId, followedAt])
  @@index([contactId])
  @@index([opportunityId])
  @@index([authorId])
  @@map("follow_ups")
}

enum FollowUpMethod {
  CALL
  VISIT
  WECHAT
  EMAIL
  MEETING
  OTHER

  @@map("follow_up_method")
}

/// A possible sale to a customer.
model Opportunity {
  id                BigInt           @id
  tenantId          BigInt           @map("tenant_id")
  customerId        BigInt           @map("customer_id")
  name              String           @db.VarChar(128)
  amount            Decimal          @db.Decimal(14, 2)
  expectedCloseDate DateTime?        @map("expected_close_date") @db.Date
  stage             OpportunityStage @default(QUALIFY)
  ownerId           BigInt           @map("owner_id")
  /// The owner's department when the opportunity was created or last transferred.
  deptId            BigInt?          @map("dept_id")
  remark            String?          @db.VarChar(1000)
  /// When it was won or lost; cleared when reopened.
  closedAt          DateTime?        @map("closed_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// A customer with opportunities cannot be deleted.
  customer   Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [deptId], references: [id], onDelete: SetNull)
  followUps  FollowUp[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@index([ownerId])
  @@index([deptId])
  @@map("opportunities")
}

enum OpportunityStage {
  QUALIFY
  NEEDS
  PROPOSAL
  NEGOTIATION
  WON
  LOST

  @@map("opportunity_stage")
}

// Files. Folders and files have an owner and the owner's department like CRM records, and what
// sits in a folder takes the folder's owner and department, so whoever sees a folder sees all of
// it. Top-level items belong to whoever created them. Deleting sets deleted_at; the contents are
// removed 30 days later.

/// A folder of the file library; parentId is null at the top level.
model FileFolder {
  id        BigInt    @id
  tenantId  BigInt    @map("tenant_id")
  parentId  BigInt?   @map("parent_id")
  name      String    @db.VarChar(100)
  ownerId   BigInt    @map("owner_id")
  deptId    BigInt?   @map("dept_id")
  creatorId BigInt    @map("creator_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent     FileFolder?  @relation("FileFolderTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children   FileFolder[] @relation("FileFolderTree")
  owner      User         @relation("FileFolderOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator    User         @relation("FileFolderCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  department Department?  @relation(fields: [deptId], references: [id], onDelete: SetNull)
  files      StoredFile[]

  @@unique([tenantId, id])
  @@index([tenantId, parentId])
  @@index([deletedAt])
  @@index([ownerId])
  @@index([deptId])
  @@index([creatorId])
  @@map("file_folders")
}

/// A file of the library. Its contents, size and type are the current version's.
model StoredFile {
  id         BigInt    @id
  tenantId   BigInt    @map("tenant_id")
  folderId   BigInt?   @map("folder_id")
  name       String    @db.VarChar(255)
  /// The current version's number.
  version    Int
  storageKey String    @map("storage_key") @db.VarChar(255)
  size       BigInt
  mimeType   String    @map("mime_type") @db.VarChar(127)
  ownerId    BigInt    @map("owner_id")
  deptId     BigInt?   @map("dept_id")
  /// Who uploaded the first version.
  creatorId  BigInt    @map("creator_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder     FileFolder?   @relation(fields: [tenantId, folderId], references: [tenantId, id], onDelete: Restrict)
  owner      User          @relation("StoredFileOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator    User          @relation("StoredFileCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  department Department?   @relation(fields: [deptId], references: [id], onDelete: SetNull)
  versions   FileVersion[]
  shares     FileShare[]
  refs       FileRef[]

  @@unique([tenantId, id])
  @@index([tenantId, folderId])
  @@index([tenantId, updatedAt])
  @@index([deletedAt])
  @@index([ownerId])
  @@index([deptId])
  @@index([creatorId])
  @@map("files")
}

/// One set of contents a file has had, the current one included. Objects in storage are never
/// changed: every version has its own.
model FileVersion {
  id           BigInt   @id
  tenantId     BigInt   @map("tenant_id")
  fileId       BigInt   @map("file_id")
  number       Int
  storageKey   String   @map("storage_key") @db.VarChar(255)
  size         BigInt
  mimeType     String   @map("mime_type") @db.VarChar(127)
  /// Who uploaded it, or restored the version it copies.
  uploaderId   BigInt   @map("uploader_id")
  /// The number of the version it was restored from.
  restoredFrom Int?     @map("restored_from")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file     StoredFile @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade)
  uploader User       @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([fileId, number])
  @@index([tenantId, fileId])
  @@index([uploaderId])
  @@map("file_versions")
}

/// A link that lets anyone holding it open a file without signing in.
model FileShare {
  id             BigInt    @id
  tenantId       BigInt    @map("tenant_id")
  fileId         BigInt    @map("file_id")
  token          String    @unique @db.VarChar(64)
  /// The extraction code the link asks for, if any.
  code           String?   @db.VarChar(8)
  /// Null for a link that never expires.
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(3)
  accessCount    Int       @default(0) @map("access_count")
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamptz(3)
  creatorId      BigInt    @map("creator_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Cascade)
  creator User       @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, fileId])
  @@index([creatorId])
  @@map("file_shares")
}

/// A record that uses a file, such as a customer it is attached to. Files in use can't be deleted.
model FileRef {
  id         BigInt        @id
  tenantId   BigInt        @map("tenant_id")
  fileId     BigInt        @map("file_id")
  targetType FileRefTarget @map("target_type")
  targetId   BigInt        @map("target_id")
  creatorId  BigInt        @map("creator_id")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [tenantId, fileId], references: [tenantId, id], onDelete: Restrict)
  creator User       @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([fileId, targetType, targetId])
  @@index([tenantId, targetType, targetId])
  @@index([creatorId])
  @@map("file_refs")
}

enum FileRefTarget {
  CUSTOMER

  @@map("file_ref_target")
}
