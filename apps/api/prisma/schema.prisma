// Conventions: snake_case table/column names, BigInt snowflake IDs generated by the application
// (no database default), timestamps stored as timestamptz.
//
// Tenant-owned rows carry tenant_id. Where every column of a relation is required, the foreign
// key includes tenant_id so the database itself refuses links across tenants; nullable links
// (a member's department, a department's parent) are checked by the services instead.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Tenant. id = 1 is reserved for the system tenant.
model Tenant {
  id        BigInt       @id
  code      String       @unique @db.VarChar(64)
  name      String       @db.VarChar(128)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  members         TenantMember[]
  departments     Department[]
  roles           Role[]
  sessions        Session[]
  lastUsedByUsers User[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  DISABLED

  @@map("tenant_status")
}

/// Sign-in account, shared by every tenant the person belongs to.
model User {
  id                 BigInt     @id
  /// Lowercase; unique across all tenants.
  username           String     @unique @db.VarChar(64)
  /// Lowercase; unique across all tenants.
  email              String?    @unique @db.VarChar(254)
  displayName        String     @map("display_name") @db.VarChar(64)
  /// Null for accounts that only sign in through OIDC.
  passwordHash       String?    @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  status             UserStatus @default(ACTIVE)
  /// Where the next sign-in lands.
  lastTenantId       BigInt?    @map("last_tenant_id")
  lastSignInAt       DateTime?  @map("last_sign_in_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  lastTenant  Tenant?        @relation(fields: [lastTenantId], references: [id], onDelete: SetNull)
  memberships TenantMember[]
  identities  UserIdentity[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// A user's membership of one tenant, holding everything that differs per tenant.
model TenantMember {
  id        BigInt       @id
  tenantId  BigInt       @map("tenant_id")
  userId    BigInt       @map("user_id")
  deptId    BigInt?      @map("dept_id")
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department?  @relation(fields: [deptId], references: [id], onDelete: SetNull)
  roles      MemberRole[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([userId])
  @@index([deptId])
  @@map("tenant_members")
}

enum MemberStatus {
  ACTIVE
  DISABLED

  @@map("member_status")
}

model Department {
  id        BigInt   @id
  tenantId  BigInt   @map("tenant_id")
  parentId  BigInt?  @map("parent_id")
  name      String   @db.VarChar(64)
  /// Ids from the root down to this department, e.g. "/12/34/", for subtree queries.
  path      String   @db.VarChar(1024)
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent     Department?      @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Department[]     @relation("DepartmentTree")
  members    TenantMember[]
  roleScopes RoleDepartment[]

  @@unique([tenantId, id])
  @@index([parentId])
  @@map("departments")
}

model Role {
  id          BigInt    @id
  tenantId    BigInt    @map("tenant_id")
  code        String    @db.VarChar(64)
  name        String    @db.VarChar(64)
  description String?   @db.VarChar(255)
  /// Built-in roles hold every permission the tenant may grant and cannot be edited or deleted.
  builtin     Boolean   @default(false)
  dataScope   DataScope @default(SELF) @map("data_scope")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     MemberRole[]
  permissions RolePermission[]
  departments RoleDepartment[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("roles")
}

/// Which rows a role may see: everything, its department (with or without sub-departments),
/// only its own, or a chosen set of departments (role_departments).
enum DataScope {
  ALL
  DEPT_AND_CHILDREN
  DEPT
  SELF
  CUSTOM

  @@map("data_scope")
}

model MemberRole {
  tenantId BigInt @map("tenant_id")
  memberId BigInt @map("member_id")
  roleId   BigInt @map("role_id")

  member TenantMember @relation(fields: [tenantId, memberId], references: [tenantId, id], onDelete: Cascade)
  role   Role         @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([tenantId, roleId])
  @@map("member_roles")
}

model RolePermission {
  roleId     BigInt @map("role_id")
  /// A code from the shared permission registry, e.g. "system:member:create".
  permission String @db.VarChar(128)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

/// The departments a role with data scope CUSTOM may see.
model RoleDepartment {
  tenantId BigInt @map("tenant_id")
  roleId   BigInt @map("role_id")
  deptId   BigInt @map("dept_id")

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  department Department @relation(fields: [tenantId, deptId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, deptId])
  @@index([tenantId, deptId])
  @@map("role_departments")
}

/// Sign-in sessions of @nestjs/authentication. The id is the SHA-256 of the cookie token.
/// user_id is text without a foreign key, as the package's store contract expects; the session
/// provider ends sessions whose user no longer exists.
model Session {
  id           String   @id
  userId       String   @map("user_id")
  /// The tenant this sign-in works in; null falls back to the user's last tenant.
  tenantId     BigInt?  @map("tenant_id")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  lastActiveAt DateTime @map("last_active_at") @db.Timestamptz(3)
  mfa          String?  @db.VarChar(16)
  metadata     Json?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// An external identity (OIDC) linked to a user.
model UserIdentity {
  id        BigInt   @id
  userId    BigInt   @map("user_id")
  /// Which identity provider, e.g. "google" or a tenant's own IdP.
  provider  String   @db.VarChar(64)
  /// The provider's subject claim.
  subject   String   @db.VarChar(255)
  email     String?  @db.VarChar(254)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("user_identities")
}
