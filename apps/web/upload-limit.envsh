# Sourced by the nginx image's entrypoint before it renders the templates. nginx turns away request
# bodies over its own limit before the API sees them, so that limit follows the API's, with room for
# the multipart framing around the file; the API still checks the file itself.
case "${FILE_MAX_SIZE_MB:-}" in
  '' | *[!0-9]*)
    echo "FILE_MAX_SIZE_MB must be a whole number of megabytes, got '${FILE_MAX_SIZE_MB:-}'" >&2
    exit 1
    ;;
esac
export NGINX_CLIENT_MAX_BODY_SIZE="$((FILE_MAX_SIZE_MB + 1))m"
