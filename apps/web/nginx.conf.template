# Rendered at container start: ${API_UPSTREAM} and ${NGINX_RESOLVER} come from the environment,
# ${NGINX_CLIENT_MAX_BODY_SIZE} from upload-limit.envsh.
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Looking the API up per request through this resolver, rather than once at start, keeps the
    # proxy working after the API container is recreated with a new address.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
        # Passes uploads on as they arrive, rather than spooling each to disk before the API sees it.
        proxy_request_buffering off;
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Build output under /assets is named by content hash, so it never changes.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Every other path is a page of the single-page app.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
