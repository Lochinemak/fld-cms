# 本地开发环境变量：cp .env.example .env 后按需修改（.env 不进 git）

NODE_ENV=development
PORT=3000

# docker compose 启动的本地 Postgres / Redis（宿主机端口避开默认的 5432 / 6379）
POSTGRES_USER=fld
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fld_asset
POSTGRES_PORT=15432
REDIS_PORT=16379

# 后端连接串，保持和上面的值一致
DATABASE_URL=postgresql://fld:change-me@localhost:15432/fld_asset
REDIS_URL=redis://localhost:16379/0

# 登录会话 Cookie 只走 HTTPS（localhost 例外）。只有用 http:// 访问非 localhost 地址时才改成 false
# SESSION_COOKIE_SECURE=true

# 前端和 API 不同源时，允许发起写请求的前端地址（逗号分隔）。同源或走 Vite 代理时不用配
# TRUSTED_ORIGINS=https://crm.example.com

# API 在反向代理后面时，相信几层代理转发的客户端 IP（Express trust proxy 写法）。建议写跳数：
# true 或包含客户端所在网段的地址，会让客户端自己伪造 IP。本地直连不用配
# TRUST_PROXY=1

# 首次启动时创建的系统租户超管用户名；初始密码随机生成，只在启动日志里打印一次
# SUPER_ADMIN_USERNAME=superadmin

# 雪花 ID 机器号（0–1023）。不配时启动时从 Redis 自动租用，多实例不会冲突
# SNOWFLAKE_WORKER_ID=

# 上传的文件存在哪里：local 本地目录（默认），s3 任意 S3 兼容存储（阿里云 OSS、腾讯云 COS、AWS S3、RustFS 等）
# STORAGE_DRIVER=local
# local 的目录，相对 API 的工作目录（apps/api），也可以写绝对路径
# STORAGE_LOCAL_DIR=storage

# 本地试 S3：docker compose --profile s3 up -d 启动 RustFS，打开控制台 http://localhost:19001，
# 用下面的密钥登录并建好桶，再打开这几行和上面的 STORAGE_DRIVER=s3。
# 配了 S3_ENDPOINT，自动测试也会对着它跑 S3 存储的用例（用单独的测试桶）
# S3_ENDPOINT=http://localhost:19000
# S3_REGION=us-east-1
# S3_BUCKET=fld-files
# S3_ACCESS_KEY_ID=fld-dev
# S3_SECRET_ACCESS_KEY=fld-dev-secret
# 自建的 RustFS 等一般要 true；阿里云 OSS 这类云存储保持 false
# S3_FORCE_PATH_STYLE=true
# 浏览器访问不到 S3_ENDPOINT 时改成 false，下载改由 API 转发
# S3_SIGNED_DOWNLOADS=true

# 单个文件的大小上限（MB）
# FILE_MAX_SIZE_MB=100
