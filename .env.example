# 本地开发环境变量：cp .env.example .env 后按需修改（.env 不进 git）

NODE_ENV=development
PORT=3000

# docker compose 启动的本地 Postgres / Redis（宿主机端口避开默认的 5432 / 6379）
POSTGRES_USER=fld
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fld_asset
POSTGRES_PORT=15432
REDIS_PORT=16379

# 后端连接串，保持和上面的值一致
DATABASE_URL=postgresql://fld:change-me@localhost:15432/fld_asset
REDIS_URL=redis://localhost:16379/0

# 登录会话 Cookie 只走 HTTPS（localhost 例外）。只有用 http:// 访问非 localhost 地址时才改成 false
# SESSION_COOKIE_SECURE=true

# 前端和 API 不同源时，允许发起写请求的前端地址（逗号分隔）。同源或走 Vite 代理时不用配
# TRUSTED_ORIGINS=https://admin.example.com

# API 在反向代理后面时，相信几层代理转发的客户端 IP（Express trust proxy 写法）。建议写跳数：
# true 或包含客户端所在网段的地址，会让客户端自己伪造 IP。本地直连不用配
# TRUST_PROXY=1

# 首次启动时创建的系统租户超管用户名；初始密码随机生成，只在启动日志里打印一次
# SUPER_ADMIN_USERNAME=superadmin

# 雪花 ID 机器号（0–1023）。不配时启动时从 Redis 自动租用，多实例不会冲突
# SNOWFLAKE_WORKER_ID=

# 上传的文件存在哪里：local 本地目录（默认），s3 任意 S3 兼容存储（阿里云 OSS、腾讯云 COS、AWS S3、RustFS 等）
# STORAGE_DRIVER=local
# local 的目录，相对 API 的工作目录（apps/api），也可以写绝对路径
# STORAGE_LOCAL_DIR=storage

# 本地试 S3：docker compose --profile s3 up -d 启动 RustFS，打开控制台 http://localhost:19001，
# 用下面的密钥登录并建好桶，再打开这几行和上面的 STORAGE_DRIVER=s3。
# 配了 S3_ENDPOINT，自动测试也会对着它跑 S3 存储的用例（用单独的测试桶）
# S3_ENDPOINT=http://localhost:19000
# S3_REGION=us-east-1
# S3_BUCKET=fld-files
# S3_ACCESS_KEY_ID=fld-dev
# S3_SECRET_ACCESS_KEY=fld-dev-secret
# 自建的 RustFS 等一般要 true；阿里云 OSS 这类云存储保持 false
# S3_FORCE_PATH_STYLE=true
# 浏览器访问不到 S3_ENDPOINT 时改成 false，下载改由 API 转发
# S3_SIGNED_DOWNLOADS=true

# 单个文件的大小上限（MB）
# FILE_MAX_SIZE_MB=100

# 邮件服务，用来发「忘记密码」的重设链接。超管也可以在「平台设置」页面里填：页面上填了的项优先，
# 留空的项用这里的值。SMTP 服务器、发件人地址、站点地址都有了，忘记密码才能用。
# 本地试：docker compose --profile mail up -d 启动 Mailpit，再打开下面这几行。
# 邮件不会真的发出去，都在 http://localhost:18025 里看
# SMTP_HOST=localhost
# SMTP_PORT=11025
# 加密方式：ssl（常用端口 465）、starttls（常用端口 587）、none 不加密。
# 不配时 465 端口用 ssl，其他端口用 starttls
# SMTP_SECURITY=none
# 服务器要登录时才配
# SMTP_USERNAME=admin@example.com
# SMTP_PASSWORD=change-me
# MAIL_FROM_ADDRESS=admin@example.com
# MAIL_FROM_NAME=Admin Dashboard
# 用户在浏览器里打开系统的地址，邮件里的链接以它开头
# SITE_URL=http://localhost:5173

# 用 Logto 登录：登录页多一个「使用 Logto 登录」按钮。超管也可以在「平台设置」页面里填：页面上填了的项优先，
# 留空的项用这里的值。下面三项加上站点地址（SITE_URL）都有了，按钮才出现。
# 在 Logto 里建「传统网页应用」（Traditional web），Redirect URI 填：站点地址/api/auth/oidc/logto/callback
# Logto 的访问地址，要用 https://，本机地址除外
# LOGTO_AUTH_URL=https://auth.example.com
# LOGTO_APP_ID=
# LOGTO_APP_SECRET=

# 加密「平台设置」页面上保存的 SMTP 密码和 Logto 应用密钥用的密钥（32 字节，base64），生成：openssl rand -base64 32
# 不配就不能在页面上保存这两项，可以改用上面的 SMTP_PASSWORD、LOGTO_APP_SECRET。
# 配了之后不要改、不要丢：换了密钥，页面上存过的这两项就解不开，要重新填。和数据库备份分开保管
# SETTINGS_ENCRYPTION_KEY=

# 审计日志保留多少天，过期的每天自动清除。最少 180 天（网络安全法要求网络日志留存不少于六个月）
# AUDIT_RETENTION_DAYS=365
