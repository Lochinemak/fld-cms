# 部署配置：cp .env.example .env 后修改（.env 不进 git），再运行 docker compose up -d

# 数据库密码，必填。请用足够长的随机字母数字串：它会拼进连接串，含 @ : / 等符号会解析出错
POSTGRES_PASSWORD=

# 镜像版本：latest 是 main 分支最新一次构建；也可以填 1.2.3 这样的版本号，或 sha-提交号
# FLD_TAG=latest

# 对外端口，浏览器访问 http://服务器:端口
# WEB_PORT=8080

# 登录 Cookie 只走 HTTPS（localhost 例外）。生产环境请在前面加 HTTPS 反向代理；
# 只在内网用 http:// 试用时才改成 false
# SESSION_COOKIE_SECURE=true

# 后端相信几层代理转发的客户端 IP（登录限流按 IP 计）。默认 1，只算 web 容器里的 nginx；
# 前面每多一层反向代理（比如 HTTPS 代理）就加 1
# TRUST_PROXY=1

# 首次启动时创建的超级管理员用户名；初始密码只在 api 容器日志里打印一次
# SUPER_ADMIN_USERNAME=superadmin

# 单个上传文件的大小上限，单位 MB。后端按它检查，web 容器里的 nginx 也按它放行
# FILE_MAX_SIZE_MB=100

# 文件存在哪里：local（默认）存在 file-storage 卷里，只支持一个 api 实例；
# s3 存到 S3 兼容的对象存储（AWS S3、云厂商的对象存储、自建的 RustFS 等）
# STORAGE_DRIVER=local

# 下面几项只在 STORAGE_DRIVER=s3 时用。用 AWS S3 本身时不填 S3_ENDPOINT
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=fld-files
# 访问密钥，两项一起填
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 用「地址/桶名」而不是「桶名.地址」访问桶；自建的对象存储（RustFS 等）大多要设成 true
# S3_FORCE_PATH_STYLE=false
# 下载时浏览器直接从对象存储取文件（短时有效的签名地址）。浏览器访问不到 S3_ENDPOINT 时
# （比如它只在服务器内网）设成 false，改由后端转发
# S3_SIGNED_DOWNLOADS=true
